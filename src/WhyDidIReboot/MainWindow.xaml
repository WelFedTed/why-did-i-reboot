<Window x:Class="WhyDidIReboot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WhyDidIReboot"
        Title="Why Did I Reboot" Width="1120" Height="780" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="#F3F4F6"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <local:CategoryConverter x:Key="Cat"/>
        <local:SubtitleConverter x:Key="Subtitle"/>
        <local:NullToCollapsedConverter x:Key="NullToCollapsed"/>
        <local:TimeConverter x:Key="Time"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <DataTemplate x:Key="EntryCard">
            <Border Background="White" CornerRadius="10" Margin="0,0,0,10" BorderBrush="#E5E7EB" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.06"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="10,0,0,10" Background="{Binding Category, Converter={StaticResource Cat}}"/>
                    <Grid Grid.Column="1" Margin="16,12,16,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Title row -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="38" Height="38" CornerRadius="19" Margin="0,0,12,0" VerticalAlignment="Top"
                                    Background="{Binding Category, Converter={StaticResource Cat}, ConverterParameter=Tint}">
                                <TextBlock Text="{Binding Category, Converter={StaticResource Cat}, ConverterParameter=Glyph}"
                                           FontFamily="{StaticResource IconFont}" FontSize="18"
                                           Foreground="{Binding Category, Converter={StaticResource Cat}}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="#111827" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Converter={StaticResource Subtitle}}" FontSize="12" Foreground="#6B7280" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Border Grid.Column="2" CornerRadius="10" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Top"
                                    Background="{Binding Category, Converter={StaticResource Cat}, ConverterParameter=Tint}">
                                <TextBlock Text="{Binding Category, Converter={StaticResource Cat}, ConverterParameter=Label}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{Binding Category, Converter={StaticResource Cat}}"/>
                            </Border>
                        </Grid>

                        <!-- Summary -->
                        <TextBlock Grid.Row="1" Text="{Binding Summary}" TextWrapping="Wrap" Foreground="#374151" Margin="50,8,0,0" LineHeight="19"/>

                        <!-- Details -->
                        <Expander Grid.Row="2" Header="Details and log records" Style="{StaticResource FlatExpander}" Margin="50,8,0,0">
                            <StackPanel Margin="0,8,0,0">
                                <ItemsControl ItemsSource="{Binding Details}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="210"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Key}" Foreground="#6B7280" FontSize="12"/>
                                                <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                         Padding="0" FontSize="12" Foreground="#111827" TextWrapping="Wrap"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Log records" FontWeight="SemiBold" Foreground="#374151" FontSize="12" Margin="0,10,0,4"/>
                                <ItemsControl ItemsSource="{Binding Evidence}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F9FAFB" CornerRadius="6" Padding="10,6" Margin="0,0,0,4">
                                                <StackPanel>
                                                    <TextBlock FontSize="11" Foreground="#6B7280">
                                                        <Run Text="{Binding Time, Mode=OneWay, Converter={StaticResource Time}}" FontWeight="SemiBold"/>
                                                        <Run Text="  ·  "/><Run Text="{Binding Log, Mode=OneWay}"/>
                                                        <Run Text="  ·  Event "/><Run Text="{Binding Id, Mode=OneWay}"/>
                                                        <Run Text="  ·  "/><Run Text="{Binding Provider, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBox Text="{Binding Message, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                             Padding="0" Margin="0,2,0,0" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Foreground="#1F2937" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Copy this entry" Style="{StaticResource LinkButton}"
                                            Command="{Binding DataContext.CopyEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                    <Button Content="Open dump folder" Style="{StaticResource LinkButton}"
                                            Visibility="{Binding DumpPath, Converter={StaticResource NullToCollapsed}}"
                                            Command="{Binding DataContext.OpenDumpCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Why Did I Reboot" FontSize="24" FontWeight="SemiBold" Foreground="#111827"/>
                    <TextBlock Text="A plain-English history of every restart, shutdown and crash on this PC, read from the Windows event log."
                               Foreground="#6B7280" Margin="0,2,16,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding Ranges}" SelectedItem="{Binding Range}" DisplayMemberPath="Label" Width="190" Padding="8,5" VerticalContentAlignment="Center"/>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding RefreshCommand}" ToolTip="Re-read the event log (F5)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Refresh"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="Export_Click" ToolTip="Save what is shown as a text or CSV file">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEDE1;" FontFamily="{StaticResource IconFont}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Export"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="EventViewer_Click" ToolTip="Open the Windows Event Viewer">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Event Viewer"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Current session banner -->
        <Border Grid.Row="1" Margin="24,16,24,0" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="14,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" Foreground="#2563EB" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentSessionText}" Foreground="#1E3A8A" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding WarningText}" Foreground="#B45309" Margin="25,4,0,0" TextWrapping="Wrap"
                           Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Border>

        <!-- Filters -->
        <Grid Grid.Row="2" Margin="24,14,24,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Style="{StaticResource ChipToggle}" IsChecked="{Binding IsChecked}" ToolTip="Click to show or hide this kind of event"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="2,0,0,4">
                    <TextBlock Text="Show:" Foreground="#6B7280" FontSize="12" Margin="0,0,8,0"/>
                    <Button Content="everything" Style="{StaticResource LinkButton}" Command="{Binding AllOnCommand}"/>
                    <Button Content="reboots only" Style="{StaticResource LinkButton}" Command="{Binding RebootsOnlyCommand}"/>
                    <Button Content="problems only" Style="{StaticResource LinkButton}" Command="{Binding ProblemsOnlyCommand}"/>
                </StackPanel>
            </StackPanel>
            <Grid Grid.Column="1" VerticalAlignment="Top" Margin="12,0,0,0">
                <TextBox x:Name="SearchBox" Width="240" Padding="28,6,8,6" VerticalContentAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}" BorderBrush="#D1D5DB"/>
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Foreground="#9CA3AF" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <TextBlock Text="Search titles, KB numbers, STOP codes…" Foreground="#9CA3AF" Margin="30,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>

        <!-- Timeline -->
        <Grid Grid.Row="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,4,24,0">
                <ItemsControl ItemsSource="{Binding View}" ItemTemplate="{StaticResource EntryCard}" Margin="0,0,0,16">
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#4B5563" Margin="2,10,0,8"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                <ProgressBar IsIndeterminate="True" Width="240" Height="6"/>
                <TextBlock Text="Reading the Windows event log…" Foreground="#6B7280" Margin="0,10,0,0" HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="&#xE9CE;" FontFamily="{StaticResource IconFont}" FontSize="36" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                <TextBlock Text="Nothing matches the current filters" Foreground="#6B7280" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                <TextBlock Text="Turn some categories back on, clear the search, or widen the date range." Foreground="#9CA3AF" FontSize="12" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="4" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="24,6">
            <Grid>
                <TextBlock Text="{Binding StatusText}" Foreground="#6B7280" FontSize="12"/>
                <TextBlock Foreground="#6B7280" FontSize="12" HorizontalAlignment="Right">
                    <Run Text="{Binding ShownCount, Mode=OneWay}"/><Run Text=" shown"/>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
