<Window x:Class="WhyDidIReboot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WhyDidIReboot"
        Title="{Binding WindowTitle}" Width="1120" Height="780" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBg}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
    <Window.Resources>
        <local:CategoryConverter x:Key="Cat"/>
        <local:SubtitleConverter x:Key="Subtitle"/>
        <local:NullToCollapsedConverter x:Key="NullToCollapsed"/>
        <local:TimeConverter x:Key="Time"/>
        <local:ExternalLinkConverter x:Key="ExternalLink"/>
        <local:SectionMatchConverter x:Key="SectionMatch"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- A TextBlock whose text is set through Highlight.Text so the current search terms are highlighted. -->
        <Style x:Key="HighlightText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="local:Highlight.Terms" Value="{Binding DataContext.SearchTerms, RelativeSource={RelativeSource AncestorType=Window}}"/>
        </Style>

        <DataTemplate x:Key="EntryCard">
            <Border Background="{DynamicResource SurfaceBg}" CornerRadius="10" Margin="0,0,0,10"
                    BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Color="{DynamicResource ShadowColor}" Opacity="{DynamicResource ShadowOpacity}"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="10,0,0,10" Background="{Binding Category, Converter={StaticResource Cat}}"/>
                    <Grid Grid.Column="1" Margin="16,12,16,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Title row -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="38" Height="38" CornerRadius="19" Margin="0,0,12,0" VerticalAlignment="Top"
                                    Background="{Binding Category, Converter={StaticResource Cat}, ConverterParameter=Tint}">
                                <TextBlock Text="{Binding Category, Converter={StaticResource Cat}, ConverterParameter=Glyph}"
                                           FontFamily="{StaticResource IconFont}" FontSize="18"
                                           Foreground="{Binding Category, Converter={StaticResource Cat}}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource HighlightText}" local:Highlight.Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Style="{StaticResource HighlightText}" local:Highlight.Text="{Binding Converter={StaticResource Subtitle}}" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="2" CornerRadius="10" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Top"
                                    Background="{Binding Category, Converter={StaticResource Cat}, ConverterParameter=Tint}">
                                <TextBlock Text="{Binding Category, Converter={StaticResource Cat}, ConverterParameter=Label}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{Binding Category, Converter={StaticResource Cat}}"/>
                            </Border>
                        </Grid>

                        <!-- Summary -->
                        <TextBlock Grid.Row="1" Style="{StaticResource HighlightText}" local:Highlight.Text="{Binding Summary}" Foreground="{DynamicResource TextSecondary}" Margin="50,8,0,0" LineHeight="19"/>

                        <!-- Updates installed shortly before, grouped (Windows / Security / Drivers / Apps / Other),
                             with descriptions from Windows Update history and KB links -->
                        <Expander Grid.Row="2" Header="Installed updates" Style="{StaticResource FlatExpander}" Margin="50,8,0,0"
                                  Visibility="{Binding HasUpdates, Converter={StaticResource BoolToVis}}">
                            <!-- Opens by itself when a search term is found among the updates -->
                            <Expander.IsExpanded>
                                <MultiBinding Converter="{StaticResource SectionMatch}" ConverterParameter="updates" Mode="OneWay">
                                    <Binding/>
                                    <Binding Path="DataContext.SearchTerms" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                </MultiBinding>
                            </Expander.IsExpanded>
                            <ItemsControl ItemsSource="{Binding UpdateGroups}" Margin="0,2,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,6,0,0">
                                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"
                                                       Typography.Capitals="AllSmallCaps" Margin="0,0,0,2"/>
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,3,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="•" Foreground="{DynamicResource TextMuted}" Margin="4,0,8,0"/>
                                                            <StackPanel Grid.Column="1">
                                                                <WrapPanel>
                                                                    <TextBlock Style="{StaticResource HighlightText}" local:Highlight.Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                                                    <TextBlock Style="{StaticResource HighlightText}" local:Highlight.Text="{Binding Category}" Foreground="{DynamicResource TextMuted}" FontSize="11"
                                                                               Margin="6,0,0,1" VerticalAlignment="Bottom" Visibility="{Binding Category, Converter={StaticResource NullToCollapsed}}"/>
                                                                    <TextBlock Style="{StaticResource HighlightText}" local:Highlight.Text="failed" Foreground="#DC2626" FontWeight="SemiBold" FontSize="11"
                                                                               Margin="8,0,0,1" VerticalAlignment="Bottom" Visibility="{Binding Failed, Converter={StaticResource BoolToVis}}"/>
                                                                </WrapPanel>
                                                                <TextBlock Style="{StaticResource HighlightText}" local:Highlight.Text="{Binding Description}" Foreground="{DynamicResource TextSecondary}" FontSize="12"
                                                                           Visibility="{Binding Description, Converter={StaticResource NullToCollapsed}}"/>
                                                                <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,2,0,0"
                                                                        Content="{Binding LinkLabel, Converter={StaticResource ExternalLink}}"
                                                                        Visibility="{Binding Url, Converter={StaticResource NullToCollapsed}}"
                                                                        Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Url}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>

                        <!-- Reference links, e.g. the Microsoft Learn page for a STOP code -->
                        <ItemsControl Grid.Row="3" ItemsSource="{Binding Links}" Margin="50,6,0,0"
                                      Visibility="{Binding HasLinks, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource LinkButton}" Content="{Binding Label, Converter={StaticResource ExternalLink}}"
                                            Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Url}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Details -->
                        <Expander Grid.Row="4" Header="Details and log records" Style="{StaticResource FlatExpander}" Margin="50,8,0,0">
                            <!-- Opens by itself when a search term is found among the details or log records -->
                            <Expander.IsExpanded>
                                <MultiBinding Converter="{StaticResource SectionMatch}" ConverterParameter="details" Mode="OneWay">
                                    <Binding/>
                                    <Binding Path="DataContext.SearchTerms" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                </MultiBinding>
                            </Expander.IsExpanded>
                            <StackPanel Margin="0,8,0,0">
                                <ItemsControl ItemsSource="{Binding Details}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="210"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Key}" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource HighlightText}" local:Highlight.Text="{Binding Value}" Foreground="{DynamicResource TextPrimary}" FontSize="12"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Log records" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,10,0,4"/>
                                <ItemsControl ItemsSource="{Binding Evidence}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource EvidenceBg}" CornerRadius="6" Padding="10,6" Margin="0,0,0,4">
                                                <StackPanel>
                                                    <WrapPanel TextBlock.FontSize="11" TextBlock.Foreground="{DynamicResource TextMuted}">
                                                        <TextBlock Text="{Binding Time, Mode=OneWay, Converter={StaticResource Time}}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="  ·  "/>
                                                        <TextBlock Style="{StaticResource HighlightText}" local:Highlight.Text="{Binding Log}"/>
                                                        <TextBlock Text="  ·  Event "/>
                                                        <TextBlock Style="{StaticResource HighlightText}" local:Highlight.Text="{Binding Id}"/>
                                                        <TextBlock Text="  ·  "/>
                                                        <TextBlock Style="{StaticResource HighlightText}" local:Highlight.Text="{Binding Provider}"/>
                                                    </WrapPanel>
                                                    <TextBlock Style="{StaticResource HighlightText}" local:Highlight.Text="{Binding Message}" Margin="0,2,0,0"
                                                               FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Copy this entry" Style="{StaticResource LinkButton}"
                                            Command="{Binding DataContext.CopyEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                    <Button Content="Open dump folder" Style="{StaticResource LinkButton}"
                                            Visibility="{Binding DumpPath, Converter={StaticResource NullToCollapsed}}"
                                            Command="{Binding DataContext.OpenDumpCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                    <!-- Only when the dump file is actually on disk: opens it in WinDbg (installing WinDbg via winget if needed) -->
                                    <Button Content="Debug in WinDbg" Style="{StaticResource LinkButton}" ToolTip="Open the crash dump in WinDbg and run !analyze -v"
                                            Visibility="{Binding DumpExists, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.OpenInWinDbgCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Why Did I Reboot" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="A plain-English history of every restart, shutdown and crash on this PC, read from the Windows event log."
                               Foreground="{DynamicResource TextMuted}" Margin="0,2,16,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox Style="{StaticResource ThemedComboBox}" ItemsSource="{Binding Ranges}" SelectedItem="{Binding Range}" Width="190"
                              ItemTemplate="{StaticResource LabelTemplate}" AutomationProperties.Name="Period" ToolTip="Which period to show"/>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding RefreshCommand}" ToolTip="Re-read the event log (F5)" AutomationProperties.Name="Refresh">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Refresh"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="Export_Click" ToolTip="Save what is shown as an HTML, text or CSV file" AutomationProperties.Name="Export">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEDE1;" FontFamily="{StaticResource IconFont}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Export"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="Settings_Click" ToolTip="Settings (F9)" AutomationProperties.Name="Settings" Padding="8,6" Width="36">
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Current session / offline source banner, plus the new-version banner -->
        <StackPanel Grid.Row="1" Margin="24,16,24,0">
            <Border Background="{DynamicResource BannerBg}" BorderBrush="{DynamicResource BannerBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource Accent}" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding CurrentSessionText}" Foreground="{DynamicResource BannerText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <Button Grid.Column="2" Content="Back to this PC" Style="{StaticResource LinkButton}" Margin="12,0,0,0" VerticalAlignment="Center"
                                Command="{Binding BackToThisPcCommand}" Visibility="{Binding IsOffline, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                    <TextBlock Text="{Binding WarningText}" Foreground="{DynamicResource WarningText}" Margin="25,4,0,0" TextWrapping="Wrap"
                               Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource BannerBg}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,8,0,0"
                    Visibility="{Binding ShowUpdateBanner, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE777;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource Accent}" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding UpdateStatus}" Foreground="{DynamicResource BannerText}" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Content="{Binding UpdateButtonText}" Style="{StaticResource LinkButton}" VerticalAlignment="Center"
                            Command="{Binding UpdateActionCommand}" ToolTip="Download, verify, install and relaunch"/>
                    <Button Grid.Column="3" Content="Dismiss" Style="{StaticResource LinkButton}" Margin="0" VerticalAlignment="Center" Command="{Binding DismissUpdateCommand}"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Filters -->
        <Grid Grid.Row="2" Margin="24,14,24,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Style="{StaticResource ChipToggle}" IsChecked="{Binding IsChecked}" ToolTip="Click to show or hide this kind of event"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="2,0,0,4">
                    <TextBlock Text="Show:" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,0,8,0"/>
                    <Button Content="default" Style="{StaticResource LinkButton}" Command="{Binding DefaultCommand}" ToolTip="Everything except sleep / wake"/>
                    <Button Content="everything" Style="{StaticResource LinkButton}" Command="{Binding AllOnCommand}"/>
                    <Button Content="reboots only" Style="{StaticResource LinkButton}" Command="{Binding RebootsOnlyCommand}"/>
                    <Button Content="problems only" Style="{StaticResource LinkButton}" Command="{Binding ProblemsOnlyCommand}"/>
                    <Button Content="none" Style="{StaticResource LinkButton}" Command="{Binding NoneCommand}"/>
                </StackPanel>
            </StackPanel>

            <!-- Search: icon and text box share one bordered container so they sit on the same baseline;
                 the "N of M shown" counter sits underneath, level with the Show: presets. -->
            <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="12,0,0,0">
            <Border Width="250" Height="30" CornerRadius="6"
                    Background="{DynamicResource ControlBg}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource TextFaint}"
                               Margin="9,0,6,0" VerticalAlignment="Center"/>
                    <!-- Clear button, shown only while there is something to clear -->
                    <Button Grid.Column="2" Width="24" Height="24" Margin="0,0,3,0" Cursor="Hand" ToolTip="Clear search (Esc)" AutomationProperties.Name="Clear search"
                            Command="{Binding ClearSearchCommand}" Visibility="{Binding HasSearch, Converter={StaticResource BoolToVis}}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{DynamicResource TextMuted}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource ControlHover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Grid Grid.Column="1">
                        <TextBox x:Name="SearchBox" Style="{StaticResource ThemedTextBox}" BorderThickness="0" Background="Transparent" Padding="0"
                                 VerticalContentAlignment="Center" VerticalAlignment="Stretch" Margin="0,0,4,0"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"/>
                        <TextBlock Text="Search titles, KB numbers, STOP codes…" Foreground="{DynamicResource TextFaint}"
                                   Margin="2,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>
            <TextBlock Text="{Binding ShownText, Mode=OneWay}" Foreground="{DynamicResource TextMuted}" FontSize="12" HorizontalAlignment="Right" Margin="0,10,2,0"/>
            </StackPanel>
        </Grid>

        <!-- Timeline -->
        <Grid Grid.Row="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,4,24,0">
                <ItemsControl ItemsSource="{Binding View}" ItemTemplate="{StaticResource EntryCard}" Margin="0,0,0,16">
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="2,10,0,8"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                <ProgressBar IsIndeterminate="True" Width="240" Height="6" BorderThickness="0" Background="{DynamicResource ControlPressed}" Foreground="{DynamicResource Accent}"/>
                <TextBlock Text="Reading the Windows event log…" Foreground="{DynamicResource TextMuted}" Margin="0,10,0,0" HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="&#xE9CE;" FontFamily="{StaticResource IconFont}" FontSize="36" Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Center"/>
                <TextBlock Text="Nothing matches the current filters" Foreground="{DynamicResource TextMuted}" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                <TextBlock Text="Turn some categories back on, clear the search, or widen the date range." Foreground="{DynamicResource TextFaint}" FontSize="12" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="4" Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="0,1,0,0" Padding="24,6">
            <Grid>
                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                <TextBlock Text="{Binding VersionTag, Mode=OneWay}" Foreground="{DynamicResource TextMuted}" FontSize="12" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
