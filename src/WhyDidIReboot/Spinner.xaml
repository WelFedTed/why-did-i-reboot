<UserControl x:Class="WhyDidIReboot.Spinner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="44" Height="44">
    <!-- A spinning dashed ring in the accent colour: the app's one busy indicator. -->
    <Ellipse x:Name="Ring" StrokeThickness="5" Stroke="{DynamicResource Accent}" StrokeDashArray="9 4.6" StrokeDashCap="Round"
             RenderTransformOrigin="0.5,0.5">
        <Ellipse.RenderTransform>
            <RotateTransform x:Name="Rotate"/>
        </Ellipse.RenderTransform>
    </Ellipse>
</UserControl>
