<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WhyDidIReboot</RootNamespace>
    <AssemblyName>WhyDidIReboot</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>Why Did I Reboot</Product>
    <AssemblyTitle>Why Did I Reboot</AssemblyTitle>
    <Description>A plain-English history of every restart, shutdown and crash on this PC.</Description>
    <Version>1.0.0</Version>
    <Company>WelFedTed</Company>
    <Copyright>Copyright © 2026</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
