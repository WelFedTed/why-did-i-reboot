<Window x:Class="WhyDidIReboot.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="500" Height="680" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBg}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Settings" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1">
            <!-- Appearance -->
            <Border Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Appearance" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Theme" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="System theme follows the Windows app mode setting." Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" Style="{StaticResource ThemedComboBox}" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}"
                                  ItemTemplate="{StaticResource LabelTemplate}" Width="150" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Log source -->
            <Border Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Log source" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Another Windows installation" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="Read System.evtx and Application.evtx from a second drive or a copied Windows folder. (F9 opens this Settings screen.)" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource ToolButton}" Margin="0" VerticalAlignment="Center" Click="Browse_Click" AutomationProperties.Name="Open offline logs">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xED25;" FontFamily="{StaticResource IconFont}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Open logs…"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="A saved CSV report" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="Re-open a .csv exported by this app, with every card intact. You can also drop a .csv or a Windows folder onto the main window." Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource ToolButton}" Margin="0" VerticalAlignment="Center" Click="Csv_Click" AutomationProperties.Name="Open CSV report">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Open CSV…"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Updates -->
            <Border Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1" CornerRadius="8" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="Updates" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                    <CheckBox Style="{StaticResource ThemedCheckBox}" Content="Check for a new version when the app starts" IsChecked="{Binding CheckUpdatesOnStartup}" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding UpdateStatus}" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                            <Button Content="Open the download page" Style="{StaticResource LinkButton}" Margin="0,4,0,0" HorizontalAlignment="Left"
                                    Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding OpenUrlCommand}" CommandParameter="{Binding UpdateUrl}"/>
                        </StackPanel>
                        <!-- Reads "Check for updates" until a newer release is found, then "Update now": one click downloads,
                             verifies, swaps the files in and relaunches. -->
                        <Button Grid.Column="1" Margin="0" VerticalAlignment="Center"
                                Command="{Binding UpdateActionCommand}" AutomationProperties.Name="{Binding UpdateButtonText}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ToolButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Accent}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE895;"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                                    <Setter Property="Text" Value="&#xE896;"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding UpdateButtonText}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding VersionText}" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                <Button Content="github.com/WelFedTed/why-did-i-reboot" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,2,0,0"
                        Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/WelFedTed/why-did-i-reboot"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Close" Style="{StaticResource ToolButton}" Width="90" VerticalAlignment="Bottom" IsCancel="True" IsDefault="True" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
