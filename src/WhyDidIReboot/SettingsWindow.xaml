<Window x:Class="WhyDidIReboot.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="460" Height="430" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBg}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Settings" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1">
            <!-- Appearance -->
            <Border Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Appearance" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Theme" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="System theme follows the Windows app mode setting." Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" Style="{StaticResource ThemedComboBox}" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}"
                                  ItemTemplate="{StaticResource LabelTemplate}" Width="150" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Updates -->
            <Border Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1" CornerRadius="8" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="Updates" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding UpdateStatus}" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                            <Button Content="Open the download page" Style="{StaticResource LinkButton}" Margin="0,4,0,0" HorizontalAlignment="Left"
                                    Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding OpenUrlCommand}" CommandParameter="{Binding UpdateUrl}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource ToolButton}" Margin="0" VerticalAlignment="Center"
                                Command="{Binding CheckForUpdatesCommand}" AutomationProperties.Name="Check for updates">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFont}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Check for updates"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding VersionText}" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                <Button Content="github.com/WelFedTed/why-did-i-reboot" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,2,0,0"
                        Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/WelFedTed/why-did-i-reboot"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Close" Style="{StaticResource ToolButton}" Width="90" VerticalAlignment="Bottom" IsCancel="True" IsDefault="True" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
