<Window x:Class="WhyDidIReboot.CustomRangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom range" Width="420" Height="300" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBg}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Show events between" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,14"/>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1" CornerRadius="8" Padding="16,14" VerticalAlignment="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="From" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <DatePicker Grid.Row="0" Grid.Column="1" x:Name="FromPicker" Style="{StaticResource ThemedDatePicker}" SelectedDateFormat="Long"/>
                <TextBlock Grid.Row="1" Text="To" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,10,14,0"/>
                <DatePicker Grid.Row="1" Grid.Column="1" x:Name="ToPicker" Style="{StaticResource ThemedDatePicker}" SelectedDateFormat="Long" Margin="0,10,0,0"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Text="Quick:" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,0,8,0"/>
                    <Button Content="this month" Style="{StaticResource LinkButton}" Click="ThisMonth_Click"/>
                    <Button Content="last month" Style="{StaticResource LinkButton}" Click="LastMonth_Click"/>
                    <Button Content="this year" Style="{StaticResource LinkButton}" Click="ThisYear_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Style="{StaticResource ToolButton}" Width="90" IsCancel="True"/>
            <Button Content="Apply" Style="{StaticResource ToolButton}" Width="90" IsDefault="True" Click="Apply_Click" AutomationProperties.Name="Apply"/>
        </StackPanel>
    </Grid>
</Window>
